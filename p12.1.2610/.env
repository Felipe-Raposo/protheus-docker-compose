# Configura banco principal e super-usuário do PostgreSQL
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Protheus12!

# Banco do Protheus
# PROTHEUS_DB=protheus
# PROTHEUS_USER=protheus
# PROTHEUS_PASSWORD=protheus

# UID/GID do usuario do host (id -u / id -g). O Postgres roda com esse
# usuario para gravar no bind mount sem chown.
HOST_UID=1000
HOST_GID=1000
