# Configura banco principal e super-usuário do PostgreSQL
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Protheus12!

# UID/GID do usuario do host (id -u / id -g). No macOS com Colima, o Postgres
# roda com esse usuario para o bind mount funcionar sem chown.
HOST_UID=502
HOST_GID=20

